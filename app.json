{
  "expo": {
    "name": "ParkFree Sydney",
    "slug": "parkfree-sydney",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F2EFE7",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.parkfree.sydney",
      "buildNumber": "1",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "ParkFree uses your location to show free parking streets near you.",
        "UIBackgroundModes": []
      }
    },
    "android": {
      "package": "com.parkfree.sydney",
      "adaptiveIcon": {
        "backgroundColor": "#F2EFE7",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "name": "ParkFree Sydney",
      "shortName": "ParkFree",
      "description": "Find free street parking in Sydney, live. Streets turn green the minute they're free.",
      "lang": "en-AU",
      "themeColor": "#F2EFE7",
      "backgroundColor": "#F2EFE7",
      "display": "standalone",
      "orientation": "portrait",
      "startUrl": "/",
      "scope": "/"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "ParkFree uses your location to show free parking streets near you."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#34D399"
        }
      ]
    ]
  }
}
